---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingButton from '../components/ui/FloatingButton.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Heading from '../components/ui/Heading.astro';
import Hero from '../components/ui/Hero.astro';
import CTA from '../components/ui/CTA.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Accordion from '../components/ui/Accordion.astro';
import { EVENT_INFO, SOCIAL_LINKS } from '../utils/constants';
---

<BaseLayout 
  title="Dive Barn 2025 - Annual Arts Festival"
  description={EVENT_INFO.description}
  type="event"
  date={EVENT_INFO.date}
>
  <!-- Theme Toggle -->
  <ThemeToggle />
  
  <!-- Navigation -->
  <Navigation />

  <!-- Floating RSVP Button -->
  <FloatingButton 
    href={SOCIAL_LINKS.rsvp}
    text="RSVP" 
    icon="→" 
    ariaLabel="RSVP for Dive Barn 2025"
  />

  <!-- Hero Section -->
  <Hero 
    id="hero"
    title="DIVE BARN 2025"
    subtitle="October 11, 2025"
    tagline="An arts and music gathering on a ranch in Mendocino County"
    backgroundImage="/media/year-one/full/morning_camping-1.JPG"
  />

  <!-- Festival Overview Section -->
  <section id="festival" class="section section--festival">
    <Heading 
      title="A Gathering Like No Other" 
      subtitle="Beginning in 2024, Dive Barn is a gathering of artists and musicians on the Yorkville Schoolhouse Ranch, a property stewarded by the Henderson/Carlson family. All are welcome to this growing, one-day festival.<br><br><a href='/schedule' class='inline-link'>See the full schedule →</a>"
    />
    <div class="festival__layout" style="margin-bottom: var(--space-xl);">
      <div class="festival__cards">
        <Card href="/schedule#music" hoverable>
          <div class="db-card-header">
            <div class="db-card-icon">🎵</div>
            <div class="db-card-content">
              <h3 class="db-card-title">Live Music</h3>
            </div>
          </div>
          <p class="db-card-text">Local Bay Area bands Town Bully and Good Actor along with various djs</p>
          <span class="db-card-link">See the line up →</span>
        </Card>
        
        <Card href="/schedule#art" hoverable>
          <div class="db-card-header">
            <div class="db-card-icon">🎨</div>
            <div class="db-card-content">
              <h3 class="db-card-title">Art Exhibition</h3>
            </div>
          </div>
          <p class="db-card-text">Curated installations and performative works scattered throughout the ranch and field, inviting exploration and discovery.</p>
          <span class="db-card-link">Discover what to see →</span>
        </Card>
        
        <Card href="/schedule#food" hoverable>
          <div class="db-card-header">
            <div class="db-card-icon">🍽️</div>
            <div class="db-card-content">
              <h3 class="db-card-title">Local Flavors</h3>
            </div>
          </div>
          <p class="db-card-text">Curated food and beverages from regional vendors, celebrating Mendocino's agricultural heritage.</p>
          <span class="db-card-link">What's for dinner? →</span>
        </Card>
      </div>
      
      <!-- <div class="festival__poster">
        <img src="/media/dive-barn-2025-poster.jpg" alt="Dive Barn 2025 Festival Poster" class="festival__poster-image">
      </div> -->
    </div>
  </section>

  <!-- RSVP Call-to-Action Banner -->
  <section class="section"> 
    <CTA 
      title="Reserve Your Spot"
      text="Join us for a one-day festival of art, music, and food. All are welcome!"
      buttonText="RSVP NOW"
      href={SOCIAL_LINKS.rsvp}
      variant="primary"
      target="_blank"
      rel="noopener"
    />
  </section>

  <!-- Gallery Section -->
  <section class="section">
    <Heading 
      title="Memories from Year 1" 
      subtitle="A glimpse into the magic we created together in 2024"
      style="margin-top: var(--space-xl);"
    />
    <div class="gallery__grid">
      <div class="gallery__item">
        <img src="/media/year-one/full/art_installation-1.JPG" 
             alt="Interactive art installation at Dive Barn 2024" 
             loading="lazy"
             class="gallery__image">
      </div>
      <div class="gallery__item">
        <img src="/media/year-one/full/community_moments-1.JPG" 
             alt="Festival attendees connecting at Dive Barn 2024" 
             loading="lazy"
             class="gallery__image">
      </div>
      <div class="gallery__item">
        <img src="/media/year-one/full/art_installation-2.JPG" 
             alt="Art installation illuminated at night at Dive Barn 2024" 
             loading="lazy"
             class="gallery__image">
      </div>
      <div class="gallery__item">
        <img src="/media/year-one/full/morning_camping-1.JPG" 
             alt="Sunrise moments after an unforgettable night at Dive Barn 2024" 
             loading="lazy"
             class="gallery__image">
      </div>
      <div class="gallery__item">
        <img src="/media/year-one/full/community_moments-2.JPG" 
             alt="Community gathering at Dive Barn 2024" 
             loading="lazy"
             class="gallery__image">
      </div>
      <div class="gallery__item">
        <img src="/media/year-one/full/art_installation-3.JPG" 
             alt="Creative art piece at Dive Barn 2024" 
             loading="lazy"
             class="gallery__image">
      </div>
    </div>
    <p class="gallery__placeholder-text">
      <em>More photos from Year 1 coming soon!</em>
    </p>
  </section>

  <!-- Essential Info Cards Section -->
  <section id="info" class="section section--info">
    <Heading 
      title="Essential Details" 
      subtitle="Everything you need to know for an incredible experience"
    />
    <div class="info__container">
      <div class="info__main">
        <div class="info__list">
          <div class="info__item">
            <div class="info__item-icon">🌅</div>
            <div class="info__item-content">
              <h3 class="info__item-title">When</h3>
              <p class="info__item-text">October 11, 2025. Gates open at 12 noon, festivities conclude at 12 midnight.</p>
            </div>
          </div>
          
          <div class="info__item">
            <div class="info__item-icon">📍</div>
            <div class="info__item-content">
              <h3 class="info__item-title">Where</h3>
              <p class="info__item-text">Yorkville Schoolhouse Ranch, Mendocino County, CA • <em>Address provided after RSVP</em></p>
            </div>
          </div>
          
          <div class="info__item info__item--urgent">
            <div class="info__item-icon">🚫</div>
            <div class="info__item-content">
              <h3 class="info__item-title">Fire Safety</h3>
              <p class="info__item-text"><strong>No campfires, candles, or flames</strong> • Ranch is extremely dry in October • Safety first, always</p>
            </div>
          </div>
          
          <div class="info__item">
            <div class="info__item-icon">🎒</div>
            <div class="info__item-content">
              <h3 class="info__item-title">Bring</h3>
              <p class="info__item-text">Personal water bottle • Warm jacket for cool nights • Comfortable dancing shoes</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="info__sidebar">
        <Card href="/yorkville-schoolhouse-ranch" hoverable>
          <div class="db-card-header">
            <div class="db-card-icon">🏛️</div>
            <div class="db-card-content">
              <h3 class="db-card-title">Historic Property</h3>
            </div>
          </div>
          <p class="db-card-text">Discover the rich history of our 2,000-acre ranch, from its origins as a schoolhouse to its role in Mendocino County's agricultural heritage.</p>
          <span class="db-card-link">Explore the Ranch →</span>
        </Card>
        
        <Card href="/financial-transparency" hoverable>
          <div class="db-card-header">
            <div class="db-card-icon">💝</div>
            <div class="db-card-content">
              <h3 class="db-card-title">Support the Festival</h3>
            </div>
          </div>
          <p class="db-card-text">See exactly how your contributions help create this magical experience. Complete transparency on funding, expenses, and goals.</p>
          <span class="db-card-link">View Transparency →</span>
        </Card>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="section section--faq">
    <Heading title="Festival FAQ" />
    <div class="faq__container">
      
      <div class="faq__category">
        <h3 class="faq__category-title">Getting There</h3>
        
        <Accordion 
          question="How do I get to the ranch?" 
          answer="After RSVPing, you'll receive the exact address and detailed directions. The ranch is about 20 minutes from Cloverdale, where you can grab last-minute supplies. We're in rural Mendocino County, so GPS might be spotty near the end."
        />
        
        <Accordion 
          question="I don't have a car. Any options?" 
          answer="Add a note in your RSVP that you need a ride. We're building a carpool board to connect festival-goers—because sharing rides means more friends and fewer emissions. Community rideshare is part of the Dive Barn spirit!"
        />
      </div>

      <div class="faq__category">
        <h3 class="faq__category-title">Staying Overnight</h3>
        
        <Accordion 
          question="Can I stay overnight?" 
          answer="Many folks choose to stay on the ranch overnight to fully experience the festival. The property offers incredible star-gazing with no light pollution. Basic facilities are available. If you plan to stay, bring what you need: shelter, warm layers, water for your entire stay (1 gallon per person per day), a headlamp (it gets DARK out here), and breakfast/snacks for the morning after."
        />
        
        <Accordion 
          question="What if I don't want to stay overnight?" 
          answer="That's totally fine! Cloverdale and Boonville have plenty of hotels and Airbnbs about 20 minutes away. October is peak season in wine country, so book early if you're planning to stay in town. Many people come for the evening and head back afterward."
        />
      </div>

      <div class="faq__category">
        <h3 class="faq__category-title">What to Bring</h3>
        
        <Accordion 
          question="What should I pack for the festival?" 
          answer="Essential items: 1 gallon of water per person per day, lunch + snacks, hat and sunscreen (it gets hot with little shade), long sleeves/sweater for nighttime, flashlight/headlamp, your health insurance card, and your dog (if you have one)! We plan on being up LATE."
        />
        
        <Accordion 
          question="Can I roast marshmallows and make s'mores?" 
          answer="<strong>ABSOLUTELY NO FIRES ON THE PROPERTY.</strong> We cannot stress this enough—the ranch is extremely dry in October and covered in kindling. One spark could destroy everything. No campfires, no candles, no flames of any kind. Please don't ruin the night. Safety first, always."
        />
      </div>

      <div class="faq__category">
        <h3 class="faq__category-title">Safety & Wellness</h3>
        
        <Accordion 
          question="What if I get hurt?" 
          answer="Be mindful of where you're walking and how you're moving, but accidents happen. If you get hurt, find one of the organizers and we'll locate first aid kits and trained organizers to help. For bigger problems, we'll call 911 (no &quot;cauterizing wounds&quot; on site!)."
        />
        
        <Accordion 
          question="Are we really in the middle of nowhere?" 
          answer="Yeah, you'll probably lose cell service around Cloverdale, but there's WiFi on the property (tech money). The ranch is rural and remote—that's part of the magic! Plan accordingly and embrace the digital detox."
        />
      </div>

      <div class="faq__category">
        <h3 class="faq__category-title">After the Festival</h3>
        
        <Accordion 
          question="I lost something important! Who do I contact?" 
          answer="First, post on the RSVP board to see if any other festival-goers picked it up. Second, email hello@divebarn.com with a description. If we find something matching, we'll get in touch!"
        />
      </div>

    </div>
  </section>

  <!-- Footer -->
  <Footer />
</BaseLayout>
