---
import type { ComponentProps } from '../../types';

interface Props extends ComponentProps {
  time?: string;
  date?: string;
  year?: string;
  venue?: string;
  title: string;
  description: string;
  category?: string;
  categoryVariant?: string;
  type?: 'schedule' | 'history';
  highlight?: boolean;
  clickable?: boolean;
  href?: string;
}

const { 
  time,
  date,
  year,
  venue,
  title,
  description,
  category,
  categoryVariant = 'default',
  type = 'schedule',
  highlight = false,
  clickable = false,
  href,
  class: className,
  ...rest 
} = Astro.props;

// Get the time display value
const timeDisplay = year || date || time || '';

// Build CSS classes
const cssClasses = [
  'db-timeline-item',
  `db-timeline-item--${type}`,
  highlight && 'db-timeline-item--highlight',
  clickable && 'db-timeline-item--clickable',
  className
].filter(Boolean).join(' ');

// Determine if this should be a link
const isLink = href && !clickable;
const Element = isLink ? 'a' : 'div';
const linkProps = isLink ? { href } : {};
---

<Element class={cssClasses} {...linkProps} {...rest}>
  <div class="db-timeline-item__time">
    <span class="db-timeline-item__time-text">{timeDisplay}</span>
  </div>
  <div class="db-timeline-item__content">
    {venue && (
      <span class="db-timeline-item__venue">{venue}</span>
    )}
    <div class="db-timeline-item__body">
      {title && (
        <div class="db-timeline-item__title">
          <h3 set:html={title} />
        </div>
      )}
      {description && (
        <div class="db-timeline-item__description">
          <p set:html={description} />
        </div>
      )}
      {category && (
        <div class={`db-timeline-item__category db-timeline-item__category--${categoryVariant}`}>
          {category}
        </div>
      )}
    </div>
  </div>
</Element>

<style>
.db-timeline-item {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  background: var(--color-surface);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--effects-shadow-sm);
  transition: all var(--effects-transition-duration-normal) var(--effects-transition-easing-ease-out);
}

.db-timeline-item[hidden] {
  display: none;
}

/* Hover effects */
.db-timeline-item:hover {
  transform: translateX(4px);
  box-shadow: var(--effects-shadow-md);
}

/* Highlighted variant */
.db-timeline-item--highlight {
  border: 2px solid var(--color-primary);
  background: linear-gradient(to right, rgba(255, 107, 107, 0.05), var(--color-surface));
}

/* Clickable state */
.db-timeline-item--clickable {
  cursor: pointer;
}

.db-timeline-item--clickable:active {
  transform: translateX(2px);
}

.db-timeline-item--clickable:focus-visible {
  outline: 3px solid var(--color-primary);
  outline-offset: 2px;
}

/* Link styling */
.db-timeline-item[href] {
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.db-timeline-item[href]:focus-visible {
  outline: 3px solid var(--color-primary);
  outline-offset: 2px;
}

/* Time/Date Column */
.db-timeline-item__time {
  text-align: right;
  padding-top: var(--spacing-xs);
}

.db-timeline-item__time-text {
  font-weight: var(--typography-font-weight-semibold);
  color: var(--color-primary);
  font-size: var(--typography-font-size-sm);
}

/* Content Column */
.db-timeline-item__venue {
  display: block;
  font-size: var(--typography-font-size-xs);
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: var(--spacing-xs);
}

.db-timeline-item__title h3 {
  font-size: var(--typography-font-size-lg);
  font-weight: var(--typography-font-weight-semibold);
  margin-bottom: var(--spacing-xs);
  color: var(--color-text-primary);
  margin-top: 0;
}

.db-timeline-item__description p {
  color: var(--color-text-muted);
  line-height: var(--typography-line-height-relaxed);
  margin-bottom: var(--spacing-sm);
  margin-top: 0;
}

.db-timeline-item__description p:last-child {
  margin-bottom: 0;
}

/* Category badges */
.db-timeline-item__category {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--border-radius-full);
  font-size: var(--typography-font-size-xs);
  font-weight: var(--typography-font-weight-medium);
  margin-top: var(--spacing-xs);
}

.db-timeline-item__category--music {
  background: rgba(255, 107, 107, 0.1);
  color: var(--color-primary);
}

.db-timeline-item__category--workshop {
  background: rgba(255, 159, 67, 0.1);
  color: var(--color-secondary);
}

.db-timeline-item__category--art {
  background: rgba(78, 205, 196, 0.1);
  color: var(--color-accent);
}

.db-timeline-item__category--community {
  background: rgba(95, 39, 205, 0.1);
  color: var(--color-deep-purple);
}

.db-timeline-item__category--food {
  background: rgba(255, 159, 67, 0.1);
  color: var(--color-secondary);
}

.db-timeline-item__category--special {
  background: rgba(78, 205, 196, 0.2);
  color: var(--color-accent);
  font-weight: var(--typography-font-weight-semibold);
}

.db-timeline-item__category--performance {
  background: rgba(95, 39, 205, 0.1);
  color: var(--color-deep-purple);
}

.db-timeline-item__category--wellness {
  background: rgba(78, 205, 196, 0.1);
  color: var(--color-accent);
}

.db-timeline-item__category--transportation {
  background: rgba(95, 39, 205, 0.1);
  color: var(--color-deep-purple);
}

.db-timeline-item__category--default {
  background: var(--color-interactive-hover);
  color: var(--color-text-muted);
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .db-timeline-item {
    grid-template-columns: 1fr;
    gap: var(--spacing-xs);
  }
  
  .db-timeline-item__time {
    text-align: left;
    padding-top: 0;
    margin-bottom: var(--spacing-xs);
  }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  .db-timeline-item {
    transition: none;
  }
  
  .db-timeline-item:hover {
    transform: none;
  }
}
</style>