---
import { NAVIGATION_LINKS } from '../../utils/constants';

// Get current pathname for active link highlighting
const pathname = Astro.url.pathname;
const isHomePage = pathname === '/';

// Helper function to determine nav link destinations
const getNavLink = (href: string, section?: string) => {
  if (section && isHomePage) {
    return `#${section}`;
  } else if (section) {
    return `/${href}#${section}`;
  }
  return href;
};

// Updated navigation links with section handling
const navLinks = [
  { 
    href: getNavLink('', 'festival'), 
    label: 'Festival',
    ariaLabel: 'Go to festival information section'
  },
  { 
    href: getNavLink('', 'info'), 
    label: 'Info',
    ariaLabel: 'Go to essential details section'
  },
  { 
    href: getNavLink('', 'faq'), 
    label: 'FAQ',
    ariaLabel: 'Go to frequently asked questions section'
  }
];
---

<nav class="nav" role="navigation" aria-label="Main navigation">
  <div class="nav__container">
    <div class="nav__logo">
      <a href="/" aria-label="Go to Dive Barn home page">
        <img src="/media/db-logo-circle.png" alt="Dive Barn Logo" class="nav__logo-image nav__logo-image--auto-spin">
      </a>
    </div>
    
    <ul class="nav__list">
      {navLinks.map(link => (
        <li>
          <a 
            href={link.href} 
            class="nav__link"
            aria-label={link.ariaLabel}
            data-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    
    <div class="nav__secondary-logo">
      <img src="/media/appleicon.png" alt="Apple Icon" class="nav__secondary-logo-image" onclick="this.classList.add('nav__secondary-logo-image--spin'); setTimeout(() => this.classList.remove('nav__secondary-logo-image--spin'), 350)">
    </div>
  </div>
</nav>