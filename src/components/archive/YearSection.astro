---
import ArtistAccordion from '../ui/ArtistAccordion.astro';
import type { ArchivePhoto } from '../../data/allPhotos';

interface Artist {
  name: string;
  instagram?: string;
  website?: string | null;
  type?: 'section';
}

interface Props {
  year: number;
  artists: Artist[];
  photos: ArchivePhoto[];
}

const { year, artists, photos } = Astro.props;
---

<section id={`year-${year}`} class="year-section">
  <div class="year-section__container">
    <h2 class="year-section__title">{year}</h2>

    <div class="year-section__content">
      <!-- Left Column: Artists -->
      <aside class="year-section__artists">
        <div class="year-section__artists-list">
          {artists.map(artist => (
            artist.type === 'section' ? (
              <h3 class="year-section__section-heading">{artist.name}</h3>
            ) : (
              <ArtistAccordion
                name={artist.name}
                instagram={artist.instagram}
                website={artist.website}
              />
            )
          ))}
        </div>
      </aside>

      <!-- Right Column: Photo Grid -->
      <div class="year-section__photos">
        <div class="year-section__photo-grid">
          {photos.map((photo, index) => (
            <div
              class="year-section__photo-item"
              data-photo-index={index}
              data-year={photo.year}
            >
              <img
                src={photo.url}
                alt={photo.caption}
                class="year-section__photo-image"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .year-section {
    padding: var(--spacing-2xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .year-section:last-of-type {
    border-bottom: none;
    padding-bottom: 80px; /* Space for navigation */
  }

  .year-section__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .year-section__title {
    font-family: var(--typography-font-family-display);
    font-size: var(--typography-font-size-3xl);
    font-weight: var(--typography-font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-xl);
  }

  .year-section__content {
    display: grid;
    grid-template-columns: 2fr 5fr;
    gap: var(--spacing-lg);
  }

  /* Artists Column */
  .year-section__artists {
    padding-right: var(--spacing-md);
  }

  .year-section__artists-list {
    display: flex;
    flex-direction: column;
  }

  .year-section__section-heading {
    font-family: var(--typography-font-family-display);
    font-size: var(--typography-font-size-lg);
    font-weight: var(--typography-font-weight-bold);
    color: var(--color-text-primary);
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }

  .year-section__section-heading:first-child {
    margin-top: 0;
  }

  /* Photo Grid */
  .year-section__photo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: var(--spacing-md);
  }

  .year-section__photo-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius-md);
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  /* Bento-box pattern - varying sizes */
  .year-section__photo-item:nth-child(6n + 1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .year-section__photo-item:nth-child(6n + 3) {
    grid-column: span 2;
    grid-row: span 1;
  }

  .year-section__photo-item:nth-child(6n + 5) {
    grid-column: span 1;
    grid-row: span 2;
  }

  .year-section__photo-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .year-section__photo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .year-section__photo-item:hover .year-section__photo-image {
    transform: scale(1.05);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .year-section__content {
      grid-template-columns: 1fr 3fr;
      gap: var(--spacing-lg);
    }

    .year-section__photo-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 180px;
    }

    .year-section__photo-item:nth-child(6n + 1) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .year-section__photo-item:nth-child(6n + 3) {
      grid-column: span 1;
      grid-row: span 1;
    }

    .year-section__photo-item:nth-child(6n + 5) {
      grid-column: span 1;
      grid-row: span 2;
    }
  }

  @media (max-width: 768px) {
    .year-section {
      padding: var(--spacing-xl) 0;
    }

    .year-section__container {
      padding: 0 var(--spacing-md);
    }

    .year-section__content {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }

    .year-section__artists {
      padding-right: 0;
    }

    .year-section__photo-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 150px;
      gap: var(--spacing-sm);
    }

    .year-section__photo-item:nth-child(6n + 1) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .year-section__photo-item:nth-child(6n + 3) {
      grid-column: span 1;
      grid-row: span 1;
    }

    .year-section__photo-item:nth-child(6n + 5) {
      grid-column: span 1;
      grid-row: span 2;
    }
  }
</style>

<script define:vars={{ photos, year }}>
  // Lightbox functionality for this year's photos
  document.addEventListener('DOMContentLoaded', () => {
    const sectionPhotos = document.querySelectorAll(`#year-${year} .year-section__photo-item`);
    const lightbox = document.getElementById('photo-lightbox');
    const overlay = document.getElementById('lightbox-overlay');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const image = document.getElementById('lightbox-image');
    const caption = document.getElementById('lightbox-caption');
    const yearEl = document.getElementById('lightbox-year');
    const photographer = document.getElementById('lightbox-photographer');
    const counter = document.getElementById('lightbox-counter');

    let currentIndex = 0;
    let currentYearPhotos = photos;

    function openLightbox(index) {
      currentIndex = index;
      updateLightboxContent();
      lightbox?.setAttribute('data-open', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox?.setAttribute('data-open', 'false');
      document.body.style.overflow = '';
    }

    function updateLightboxContent() {
      const photo = currentYearPhotos[currentIndex];
      if (!photo) return;

      if (image) image.src = photo.url;
      if (image) image.alt = photo.caption;
      if (caption) caption.textContent = photo.caption;
      if (yearEl) yearEl.textContent = photo.year.toString();
      if (photographer) {
        const photographerName = photo.photographer
          .replace(/-/g, ' ')
          .split(' ')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');

        photographer.textContent = photo.photographer !== 'unknown'
          ? `Photo by: ${photographerName}`
          : photographerName;
      }
      if (counter) counter.textContent = `${currentIndex + 1} / ${currentYearPhotos.length}`;
    }

    function nextPhoto() {
      currentIndex = (currentIndex + 1) % currentYearPhotos.length;
      updateLightboxContent();
    }

    function prevPhoto() {
      currentIndex = (currentIndex - 1 + currentYearPhotos.length) % currentYearPhotos.length;
      updateLightboxContent();
    }

    // Event listeners (shared across all year sections, so only add once)
    if (!window.__lightboxInitialized) {
      overlay?.addEventListener('click', closeLightbox);
      closeBtn?.addEventListener('click', closeLightbox);
      prevBtn?.addEventListener('click', prevPhoto);
      nextBtn?.addEventListener('click', nextPhoto);

      document.addEventListener('keydown', (e) => {
        if (lightbox?.getAttribute('data-open') !== 'true') return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') prevPhoto();
        if (e.key === 'ArrowRight') nextPhoto();
      });

      window.__lightboxInitialized = true;
    }

    // Click handlers for photos in this section
    sectionPhotos.forEach((item, index) => {
      item.addEventListener('click', () => {
        currentYearPhotos = photos;
        openLightbox(index);
      });
    });
  });
</script>
