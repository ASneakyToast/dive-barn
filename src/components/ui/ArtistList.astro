---
interface Artist {
  name: string;
  instagram?: string | null;
  website?: string | null;
}

interface Props {
  artists: Artist[];
  class?: string;
}

const { artists, class: className } = Astro.props;
---

<div class={`artist-list ${className || ''}`}>
  {artists.map((artist) => (
    <details class="artist-list__item">
      <summary class="artist-list__summary">
        <span class="artist-list__name">{artist.name}</span>
      </summary>
      <div class="artist-list__content">
        {artist.website && (
          <a
            href={artist.website}
            target="_blank"
            rel="noopener noreferrer"
            class="artist-list__link"
            aria-label={`Visit ${artist.name}'s website`}
          >
            Website →
          </a>
        )}
        {artist.instagram && (
          <a
            href={artist.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="artist-list__link"
            aria-label={`Visit ${artist.name} on Instagram`}
          >
            Instagram →
          </a>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .artist-list {
    display: flex;
    flex-direction: column;
  }

  .artist-list__item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .artist-list__item:last-child {
    border-bottom: none;
  }

  .artist-list__summary {
    padding: var(--spacing-sm) 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.2s ease;
  }

  .artist-list__summary:hover {
    color: var(--color-primary);
  }

  .artist-list__summary::marker,
  .artist-list__summary::-webkit-details-marker {
    display: none;
  }

  .artist-list__summary::after {
    content: '→';
    font-size: var(--typography-font-size-sm);
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .artist-list__item[open] .artist-list__summary::after {
    content: '↓';
  }

  .artist-list__name {
    font-size: var(--typography-font-size-base);
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-text-primary);
  }

  .artist-list__content {
    padding: 0 0 var(--spacing-sm) var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .artist-list__link {
    font-size: var(--typography-font-size-sm);
    color: var(--color-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    font-weight: var(--typography-font-weight-medium);
    display: inline-flex;
    align-items: center;
    width: fit-content;
  }

  .artist-list__link:hover {
    color: var(--color-secondary);
    transform: translateX(2px);
  }
</style>
