---
interface Props {
  question: string;
  answer: string;
  open?: boolean;
}

const { question, answer, open = false } = Astro.props;
---

<details class="db-accordion-item" open={open}>
  <summary class="db-accordion-item__question">{question}</summary>
  <div class="db-accordion-item__answer">
    <p set:html={answer} />
  </div>
</details>

<style>
  .db-accordion-item {
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: var(--radius-medium, 0.5rem);
    margin-bottom: 1rem;
    overflow: hidden;
    background: var(--color-surface, #ffffff);
  }

  .db-accordion-item__question {
    background: var(--color-surface-elevated, #f9f9f9);
    padding: 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-primary, #1a1a1a);
    user-select: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .db-accordion-item__question:hover {
    background: var(--color-surface-hover, #f0f0f0);
  }

  .db-accordion-item__question::marker {
    display: none;
  }

  .db-accordion-item__question::-webkit-details-marker {
    display: none;
  }

  .db-accordion-item__question::before {
    content: '+';
    float: right;
    font-size: 1.2em;
    font-weight: bold;
    transition: transform 0.2s ease;
  }

  .db-accordion-item[open] .db-accordion-item__question::before {
    content: '−';
  }

  .db-accordion-item__answer {
    padding: 1rem;
    line-height: 1.6;
    background: var(--color-surface, #ffffff);
    color: var(--color-text-primary, #1a1a1a);
  }

  .db-accordion-item__answer p {
    margin: 0;
    color: var(--color-text-primary, #1a1a1a);
  }

  .db-accordion-item__answer strong {
    font-weight: var(--font-weight-bold, 700);
    color: var(--color-text-emphasis, #000000);
  }
</style>