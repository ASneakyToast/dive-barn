---
// PhotoWall component - Masonry grid with filtering
import type { ArchivePhoto } from '../../data/allPhotos';

interface Props {
  photos: ArchivePhoto[];
}

const { photos } = Astro.props;
---

<div class="photo-wall">
  <div class="photo-wall__container">
    <div class="photo-wall__grid" id="photo-grid">
      {photos.map((photo, index) => (
        <div
          class="photo-wall__item"
          data-photo-index={index}
          data-year={photo.year}
          data-photographer={photo.photographer}
          data-categories={photo.categories.join(',')}
          data-caption={photo.caption.toLowerCase()}
          data-filename={photo.filename.toLowerCase()}
        >
          <img
            src={photo.url}
            alt={photo.caption}
            class="photo-wall__image"
            loading="lazy"
          />
          <div class="photo-wall__overlay">
            <div class="photo-wall__info">
              <span class="photo-wall__year">{photo.year}</span>
              {photo.photographer !== 'unknown' && (
                <span class="photo-wall__photographer">{photo.photographer.replace(/-/g, ' ')}</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="photo-wall__empty" id="no-results" style="display: none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <h3>No photos found</h3>
      <p>Try adjusting your filters or search query</p>
    </div>
  </div>
</div>

<style>
  .photo-wall {
    padding: var(--spacing-xl) 0;
  }

  .photo-wall__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .photo-wall__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-md);
    grid-auto-flow: dense;
  }

  .photo-wall__item {
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius-md);
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.3s ease;
    aspect-ratio: 1;
  }

  .photo-wall__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .photo-wall__item:hover .photo-wall__overlay {
    opacity: 1;
  }

  .photo-wall__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .photo-wall__item:hover .photo-wall__image {
    transform: scale(1.05);
  }

  .photo-wall__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.7) 0%, transparent 50%, rgba(0, 0, 0, 0.7) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    padding: var(--spacing-md);
  }

  .photo-wall__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .photo-wall__year,
  .photo-wall__photographer {
    color: white;
    font-size: var(--typography-font-size-sm);
    font-weight: var(--typography-font-weight-medium);
    text-transform: capitalize;
  }

  .photo-wall__year {
    font-weight: var(--typography-font-weight-bold);
  }

  /* Empty state */
  .photo-wall__empty {
    text-align: center;
    padding: var(--spacing-3xl) var(--spacing-xl);
    color: var(--color-text-secondary);
  }

  .photo-wall__empty svg {
    margin: 0 auto var(--spacing-lg);
    opacity: 0.5;
  }

  .photo-wall__empty h3 {
    font-size: var(--typography-font-size-xl);
    font-weight: var(--typography-font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  .photo-wall__empty p {
    font-size: var(--typography-font-size-base);
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .photo-wall__grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .photo-wall {
      padding: var(--spacing-lg) 0;
    }

    .photo-wall__container {
      padding: 0 var(--spacing-md);
    }

    .photo-wall__grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--spacing-sm);
    }
  }

  @media (max-width: 480px) {
    .photo-wall__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Hide filtered items */
  .photo-wall__item[data-filtered="true"] {
    display: none;
  }
</style>

<script define:vars={{ photos }}>
  // Photo wall filtering and lightbox functionality
  let currentYear = 'all';
  let allPhotosData = photos;
  let currentPhotoIndex = 0;

  function applyFilters() {
    const grid = document.getElementById('photo-grid');
    const items = grid?.querySelectorAll('.photo-wall__item');
    const noResults = document.getElementById('no-results');
    let visibleCount = 0;

    items?.forEach((item) => {
      const year = item.getAttribute('data-year');
      let show = true;

      // Year filter
      if (currentYear !== 'all' && year !== currentYear) {
        show = false;
      }

      if (show) {
        item.removeAttribute('data-filtered');
        visibleCount++;
      } else {
        item.setAttribute('data-filtered', 'true');
      }
    });

    // Show/hide empty state
    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // Update count
    const countElement = document.getElementById('photo-count');
    if (countElement) {
      countElement.textContent = `Showing ${visibleCount} of ${items?.length || 0} photos`;
    }
  }

  // Filter button handlers
  function setupFilterButtons() {
    const filterButtons = document.querySelectorAll('.filter-pill');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-value');
        if (!value) return;

        // Update active state
        const siblings = button.parentElement?.querySelectorAll('.filter-pill');
        siblings?.forEach(sib => sib.removeAttribute('data-active'));
        button.setAttribute('data-active', 'true');

        // Update filter
        currentYear = value;
        applyFilters();
      });
    });
  }

  // Lightbox functionality
  function setupLightbox() {
    const lightbox = document.getElementById('photo-lightbox');
    const overlay = document.getElementById('lightbox-overlay');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const image = document.getElementById('lightbox-image');
    const caption = document.getElementById('lightbox-caption');
    const year = document.getElementById('lightbox-year');
    const photographer = document.getElementById('lightbox-photographer');
    const counter = document.getElementById('lightbox-counter');

    function openLightbox(index) {
      currentPhotoIndex = index;
      updateLightboxContent();
      lightbox?.setAttribute('data-open', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox?.setAttribute('data-open', 'false');
      document.body.style.overflow = '';
    }

    function updateLightboxContent() {
      const photo = allPhotosData[currentPhotoIndex];
      if (!photo) return;

      if (image) image.src = photo.url;
      if (image) image.alt = photo.caption;
      if (caption) caption.textContent = photo.caption;
      if (year) year.textContent = photo.year.toString();
      if (photographer) photographer.textContent = photo.photographer.replace(/-/g, ' ');
      if (counter) counter.textContent = `${currentPhotoIndex + 1} / ${allPhotosData.length}`;
    }

    function nextPhoto() {
      currentPhotoIndex = (currentPhotoIndex + 1) % allPhotosData.length;
      updateLightboxContent();
    }

    function prevPhoto() {
      currentPhotoIndex = (currentPhotoIndex - 1 + allPhotosData.length) % allPhotosData.length;
      updateLightboxContent();
    }

    // Event listeners
    overlay?.addEventListener('click', closeLightbox);
    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', prevPhoto);
    nextBtn?.addEventListener('click', nextPhoto);

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (lightbox?.getAttribute('data-open') !== 'true') return;

      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevPhoto();
      if (e.key === 'ArrowRight') nextPhoto();
    });

    // Click on photos
    const photoItems = document.querySelectorAll('.photo-wall__item');
    photoItems.forEach(item => {
      item.addEventListener('click', () => {
        const index = parseInt(item.getAttribute('data-photo-index') || '0');
        openLightbox(index);
      });
    });
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    setupFilterButtons();
    setupLightbox();
    applyFilters(); // Initial count
  });
</script>
