---
import type { ComponentProps } from '../../types';

interface Props extends ComponentProps {
  variant?: 'default' | 'compact' | 'hero';
  title?: string;
  description?: string;
}

const {
  variant = 'default',
  title = 'Get Updates for 2026',
  description = 'Be the first to know when we announce the date, open artist applications, and share other festival news.',
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'newsletter',
  variant !== 'default' && `newsletter--${variant}`,
  className
].filter(Boolean).join(' ');
---

<div class={classes} {...rest}>
  <div class="newsletter__container">
    {variant !== 'compact' && (
      <div class="newsletter__header">
        <h3 class="newsletter__title">{title}</h3>
        <p class="newsletter__description">{description}</p>
      </div>
    )}
    <div class="newsletter__cta">
      <a
        href="https://dive-barn-newsletter.beehiiv.com/subscribe"
        target="_blank"
        rel="noopener"
        class="newsletter__button"
      >
        Subscribe to Newsletter
      </a>
      <p class="newsletter__privacy">
        We'll send occasional updates about Dive Barn 2026. No spam, ever.
      </p>
    </div>
  </div>
</div>

<style>
.newsletter {
  width: 100%;
}

.newsletter__container {
  max-width: 600px;
  margin: 0 auto;
}

.newsletter__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.newsletter__title {
  font-family: var(--typography-font-family-display);
  font-size: var(--typography-font-size-xl);
  font-weight: var(--typography-font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  line-height: var(--typography-line-height-tight);
}

.newsletter__description {
  font-size: var(--typography-font-size-base);
  color: var(--color-text-secondary);
  line-height: var(--typography-line-height-relaxed);
  margin: 0;
}

.newsletter__cta {
  width: 100%;
  text-align: center;
}

.newsletter__button {
  display: inline-block;
  padding: var(--spacing-md) var(--spacing-xl);
  background: var(--color-primary);
  color: var(--color-text-light);
  border: none;
  border-radius: var(--border-radius-md);
  font-size: var(--typography-font-size-base);
  font-weight: var(--typography-font-weight-semibold);
  font-family: var(--typography-font-family-base);
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.2s ease;
  white-space: nowrap;
  margin-bottom: var(--spacing-md);
}

.newsletter__button:hover {
  background: var(--color-primary-dark);
  transform: translateY(-2px);
}

.newsletter__privacy {
  font-size: var(--typography-font-size-sm);
  color: var(--color-text-muted);
  text-align: center;
  margin: 0;
}

/* Hero variant */
.newsletter--hero {
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  padding: var(--spacing-lg);
  border-radius: var(--border-radius-lg);
}

.newsletter--hero .newsletter__title {
  color: var(--color-text-light);
}

.newsletter--hero .newsletter__description {
  color: rgba(255, 255, 255, 0.9);
}

.newsletter--hero .newsletter__privacy {
  color: rgba(255, 255, 255, 0.7);
}

/* Compact variant */
.newsletter--compact .newsletter__cta {
  max-width: 400px;
  margin: 0 auto;
}

/* Responsive adjustments */
@media (max-width: 640px) {
  .newsletter__button {
    width: 100%;
    max-width: 300px;
  }

  .newsletter__title {
    font-size: var(--typography-font-size-lg);
  }
}
</style>
