---
interface Props {
  name: string;
  instagram?: string;
  website?: string | null;
  open?: boolean;
}

const { name, instagram, website, open = false } = Astro.props;
---

<details class="artist-accordion" open={open}>
  <summary class="artist-accordion__name">{name}</summary>
  <div class="artist-accordion__content">
    <div class="artist-accordion__links">
      {instagram && (
        <a href={instagram} target="_blank" rel="noopener noreferrer" class="artist-accordion__link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          Instagram
        </a>
      )}
      {website && (
        <a href={website} target="_blank" rel="noopener noreferrer" class="artist-accordion__link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          Website
        </a>
      )}
    </div>
  </div>
</details>

<style>
  .artist-accordion {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    margin-bottom: var(--spacing-xs);
    overflow: hidden;
    background: var(--color-surface);
  }

  .artist-accordion__name {
    background: var(--color-surface);
    padding: var(--spacing-sm) var(--spacing-md);
    cursor: pointer;
    list-style: none;
    font-weight: var(--typography-font-weight-medium);
    color: var(--color-text-primary);
    user-select: none;
    transition: background-color 0.2s ease;
    font-size: var(--typography-font-size-sm);
  }

  .artist-accordion__name:hover {
    background: var(--color-surface-variant);
  }

  .artist-accordion__name::marker {
    display: none;
  }

  .artist-accordion__name::-webkit-details-marker {
    display: none;
  }

  .artist-accordion__name::before {
    content: '+';
    float: right;
    font-size: 1.1em;
    font-weight: bold;
    transition: transform 0.2s ease;
  }

  .artist-accordion[open] .artist-accordion__name::before {
    content: '−';
  }

  .artist-accordion__content {
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-surface);
  }

  .artist-accordion__links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .artist-accordion__link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    font-size: var(--typography-font-size-sm);
    color: var(--color-primary);
    text-decoration: none;
    transition: all 0.2s ease;
    width: fit-content;
  }

  .artist-accordion__link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .artist-accordion__link svg {
    flex-shrink: 0;
  }
</style>
