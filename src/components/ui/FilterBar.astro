---
// FilterBar component - Year filtering for photo archive
interface Props {
  years: number[];
}

const { years } = Astro.props;
---

<div class="filter-bar" id="filter-bar">
  <div class="filter-bar__container">
    <div class="filter-bar__content">
      <!-- Filter Pills -->
      <div class="filter-pills" id="filter-pills">
        <button class="filter-pill" data-filter-type="view" data-value="all" data-active="true">
          All
        </button>
        {years.map(year => (
          <button class="filter-pill" data-filter-type="view" data-value={year}>
            {year}
          </button>
        ))}
        <button class="filter-pill" data-filter-type="view" data-value="artists">
          Artists
        </button>
      </div>

      <!-- Photo Count -->
      <div class="filter-stats">
        <span id="photo-count" class="filter-stats__text"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .filter-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-sm) 0;
    backdrop-filter: blur(10px);
    background: rgba(var(--color-background-rgb, 255, 255, 255), 0.95);
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.04);
  }

  .filter-bar__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .filter-bar__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .filter-pills {
    display: flex;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .filter-pill {
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border-radius: 100px;
    font-size: 12px;
    font-weight: var(--typography-font-weight-medium);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    line-height: 1.4;
  }

  .filter-pill:hover {
    border-color: var(--color-primary);
    background: var(--color-surface-variant);
  }

  .filter-pill[data-active="true"] {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .filter-stats {
    font-size: 12px;
    color: var(--color-text-secondary);
    font-weight: var(--typography-font-weight-medium);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .filter-bar {
      padding: var(--spacing-sm) 0;
    }

    .filter-bar__container {
      padding: 0 var(--spacing-md);
    }

    .filter-bar__content {
      gap: var(--spacing-sm);
    }

    .filter-pill {
      padding: 4px 10px;
      font-size: 11px;
    }

    .filter-stats {
      font-size: 11px;
    }
  }
</style>
