---
import type { HeadingLevel, ComponentProps } from '../../types';

interface Props extends ComponentProps {
  title: string;
  subtitle?: string;
  tagline?: string;
  backgroundImage?: string;
  backgroundImages?: string[];
  variant?: 'default' | 'financial' | 'ranch';
  level?: HeadingLevel;
}

const {
  title,
  subtitle,
  tagline,
  backgroundImage,
  backgroundImages,
  variant = 'default',
  level = 1,
  class: className,
  ...rest
} = Astro.props;

const HeadingTag = `h${level}` as keyof HTMLElementTagNameMap;
const SubtitleTag = `h${level + 1}` as keyof HTMLElementTagNameMap;

const classes = [
  'hero',
  variant !== 'default' && `hero--${variant}`,
  backgroundImages && 'hero--slideshow',
  className
].filter(Boolean).join(' ');

const heroStyle = backgroundImage
  ? `background-image: url('${backgroundImage}'); background-size: cover; background-position: center;`
  : '';
---

<section class={classes} style={heroStyle} {...rest}>
  {backgroundImages && (
    <div class="hero__slideshow">
      {backgroundImages.map((image, index) => (
        <div
          class="hero__slide"
          style={`background-image: url('${image}'); animation-delay: ${index * 4}s;`}
        />
      ))}
    </div>
  )}
  <div class="hero__container">
    <div class="hero__content">
      <HeadingTag class="hero__title">{title}</HeadingTag>
      {subtitle && (
        <SubtitleTag class="hero__subtitle">{subtitle}</SubtitleTag>
      )}
      {tagline && (
        <p class="hero__tagline">{tagline}</p>
      )}
      <slot />
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-hero-gradient-start) 0%, var(--color-hero-gradient-end) 100%);
  color: var(--color-text-light);
  overflow: hidden;
}

.hero__container {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
  text-align: center;
  z-index: 2;
}

.hero__content {
  animation: slideInUp 0.8s ease-out;
}

.hero__title {
  font-family: var(--typography-font-family-display);
  font-size: clamp(var(--typography-font-size-2xl), 6vw, var(--typography-font-size-4xl));
  font-weight: var(--typography-font-weight-black);
  line-height: var(--typography-line-height-tight);
  margin-bottom: var(--spacing-xl);
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.hero__subtitle {
  font-family: var(--typography-font-family-display);
  font-size: clamp(var(--typography-font-size-lg), 3vw, var(--typography-font-size-xl));
  font-weight: var(--typography-font-weight-semibold);
  line-height: var(--typography-line-height-normal);
  margin-bottom: var(--spacing-md);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

.hero__tagline {
  font-size: var(--typography-font-size-lg);
  font-weight: var(--typography-font-weight-normal);
  line-height: var(--typography-line-height-relaxed);
  margin-bottom: var(--spacing-lg);
  opacity: 0.9;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

/* Hero variants */
.hero--financial .hero__title,
.hero--ranch .hero__title {
  color: var(--color-text-light);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .hero {
    min-height: 50vh;
    padding: var(--spacing-xl) 0;
  }
  
  .hero__container {
    padding: 0 var(--spacing-md);
  }
  
  .hero__tagline {
    font-size: var(--typography-font-size-base);
    margin-bottom: var(--spacing-md);
  }
}

/* Animation */
@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .hero__content {
    animation: none;
  }

  .hero__slide {
    animation: none !important;
  }

  .hero__slide:not(:first-child) {
    display: none;
  }
}

/* Hero Slideshow */
.hero__slideshow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero__slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  opacity: 0;
  animation: heroSlideshow 20s infinite;
}

.hero__slide:first-child {
  animation-delay: 0s;
}

.hero__slide:last-child {
  /* Last image holds until loop for seamless restart */
  animation: heroSlideshowLast 20s infinite;
}

/* Smooth crossfade with 1s overlap */
/* Each image: 1s fade in, 3s hold, 1s fade out */
@keyframes heroSlideshow {
  0% { opacity: 0; }       /* Hidden */
  5% { opacity: 1; }       /* Fade in (0-1s) */
  20% { opacity: 1; }      /* Hold (1-4s) */
  25% { opacity: 0; }      /* Fade out (4-5s) */
  100% { opacity: 0; }     /* Stay hidden */
}

/* Last image: fades out to overlap with first image's fade-in at loop */
@keyframes heroSlideshowLast {
  0% { opacity: 0; }       /* Hidden */
  5% { opacity: 1; }       /* Fade in (0-1s) */
  15% { opacity: 1; }      /* Hold (1-3s) */
  20% { opacity: 0; }      /* Fade out (3-4s) - overlaps with loop */
  100% { opacity: 0; }     /* Hidden */
}

/* Dark overlay for better text readability on slideshow */
.hero--slideshow::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1;
}

.hero--slideshow .hero__container {
  z-index: 2;
  position: relative;
}
</style>