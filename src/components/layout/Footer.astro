---
interface Props {
  showTransparency?: boolean;
  lastUpdated?: string;
}

const {
  showTransparency = false,
  lastUpdated = 'August 20, 2025'
} = Astro.props;
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__content">
      <div class="footer__section">
        <h3 class="footer__title">
          <a href="/" class="footer__title-link">Dive Barn</a>
        </h3>
        <p class="footer__text">
          Two years of unforgettable music and arts experiences at
          <a href="/yorkville-schoolhouse-ranch" class="footer__inline-link">Yorkville Schoolhouse Ranch</a>
          (2024-2025).
        </p>
      </div>

      <div class="footer__section">
        <h4 class="footer__subtitle">Get In Touch</h4>
        <div class="footer__contact">
          <p class="footer__contact-item">
            <strong>Email:</strong>
            <a href="mailto:divebarnranch@gmail.com" class="footer__contact-link">
              divebarnranch@gmail.com
            </a>
          </p>
          <p class="footer__contact-item">
            <strong>Instagram:</strong>
            <a
              href="https://instagram.com/divebarnranch"
              class="footer__contact-link"
              target="_blank"
              rel="noopener"
            >
              @divebarnranch
            </a>
          </p>
        </div>
      </div>

      <div class="footer__section">
        <h4 class="footer__subtitle">The Organizers</h4>
        <div class="footer__contact">
          <p class="footer__contact-item">
            <a
              href="https://thisisahousegallery.com"
              class="footer__contact-link"
              target="_blank"
              rel="noopener"
            >
              This Is A House Gallery
            </a>
          </p>
          <p class="footer__contact-item">
            <a
              href="https://www.instagram.com/offhours_sf/"
              class="footer__contact-link"
              target="_blank"
              rel="noopener"
            >
              Off Hours SF
            </a>
          </p>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; 2024-2025 Dive Barn. All rights reserved.</p>
      {showTransparency && (
        <p class="footer__transparency">
          Last updated: <span id="last-updated">{lastUpdated}</span>
        </p>
      )}
    </div>
  </div>
</footer>