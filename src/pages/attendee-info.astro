---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingButton from '../components/ui/FloatingButton.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Heading from '../components/ui/Heading.astro';
import Accordion from '../components/ui/Accordion.astro';
import CTA from '../components/ui/CTA.astro';
import { EVENT_INFO, SOCIAL_LINKS } from '../utils/constants';

// Import images for optimization
import heroImage from '../../public/media/hero-attendee-info.jpg';
import mapScreenshot from '../../public/media/map-screenshot.jpg';
import campingImg1 from '../../public/media/year-one/full/morning_camping-2.JPG';
import campingImg2 from '../../public/media/year-one/full/morning_camping-1.JPG';
import campingImg3 from '../../public/media/year-one/full/community_moments-3.JPG';
---

<BaseLayout
  title="Attendee Information - Dive Barn 2025"
  description="Everything you need to know for Dive Barn 2025 - address, directions, what to bring, carpooling, and more"
  type="event"
  date={EVENT_INFO.date}
>
  <!-- Theme Toggle -->
  <ThemeToggle />

  <!-- Navigation -->
  <Navigation />

  <main class="main">
    <!-- Hero Section -->
    <section class="hero hero--attendee" aria-label="Dive Barn 2025 Festival Information">
      <Image src={heroImage} alt="Dive Barn 2025 Festival Map" class="hero__image" width={1920} />
    </section>

    <!-- Welcome Section -->
    <section class="section section--welcome">
      <div class="welcome__container">
        <h1 class="welcome__title">Welcome to Dive Barn 2025!</h1>
        <p class="welcome__text">We're thrilled you're joining us for a day of music, art, and community on October 11th. This page has everything you need to prepare for an unforgettable experience at the ranch.</p>
      </div>
    </section>

    <!-- Address & Map Section -->
    <section class="section section--address">
      <div class="container">
        <Heading title="Getting There" />
        <div class="info__container">
          <div class="info__main">
            <h3 class="info__item-title">Address & Directions</h3>
            <p class="info__item-text">
              <strong>Yorkville Schoolhouse Ranch</strong><br>
              <a href="https://www.google.com/maps/search/?api=1&query=31340+CA-128,+Yorkville,+CA+95494" target="_blank" rel="noopener" class="info__item-link">31340 CA-128, Yorkville, CA 95494</a>
            </p>
            <p class="info__item-text">
              The ranch is about 20 minutes from Cloverdale, where you can grab last-minute supplies.
              GPS might be spotty near the end, so make sure to download offline maps or print directions.
            </p>
            <p class="info__item-text">
              <strong>Parking:</strong> Free on-site parking available. Arrive early for the best spots if you're planning to camp overnight.
            </p>
            <a href="/media/dive-barn-map.pdf" class="info__item-link" download>
              Download Map →
            </a>
          </div>

          <div class="info__sidebar">
            <div class="info__gallery">
              <a href="/media/dive-barn-map.pdf" download>
                <Image src={mapScreenshot} alt="Map to Yorkville Schoolhouse Ranch" class="info__gallery-image" width={800} />
              </a>
              <p class="image-caption">Click to download venue map PDF</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Camping Section -->
    <section class="section section--camping">
      <div class="container">
        <Heading title="Camping" subtitle="Planning to stay overnight? Here's everything you need to know" />
        <div class="info__container">
          <div class="info__main">
            <div class="info__list">
              <div class="info__item">
                <div class="info__item-content">
                  <h3 class="info__item-title">Shelter & Sleep</h3>
                  <p class="info__item-text">Bring a tent or shelter, warm sleeping bag (October nights get cold!), sleeping pad, and headlamp. Arrive early to set up camp and claim your spot before festivities begin at noon.</p>
                </div>
              </div>

              <div class="info__item">
                <div class="info__item-content">
                  <h3 class="info__item-title">Food & Water</h3>
                  <p class="info__item-text">1 gallon of water per person per day • Personal water bottle • Lunch and snacks • Breakfast for the morning after. We'll have food service during the festival.</p>
                </div>
              </div>

              <div class="info__item">
                <div class="info__item-content">
                  <h3 class="info__item-title">Facilities</h3>
                  <p class="info__item-text">Porta potties on-site, but no showers. Hotels in Cloverdale and Boonville are 20 minutes away if you prefer full amenities.</p>
                </div>
              </div>

              <div class="info__item">
                <div class="info__item-content">
                  <h3 class="info__item-title">Stargazing</h3>
                  <p class="info__item-text">No light pollution means incredible views of the Milky Way. Bring a headlamp—it gets DARK out here! Perfect for late-night sky watching after the music.</p>
                </div>
              </div>

              <div class="info__item info__item--urgent">
                <div class="info__item-content">
                  <h3 class="info__item-title">Fire Safety</h3>
                  <p class="info__item-text"><strong>NO campfires, candles, or flames</strong> • Ranch is extremely dry in October • Safety first, always</p>
                </div>
              </div>
            </div>
          </div>

          <div class="info__sidebar">
            <div class="info__gallery">
              <Image src={campingImg1} alt="Morning camping at Dive Barn 2024" class="info__gallery-image" width={600} />
              <Image src={campingImg2} alt="Tents set up at the ranch" class="info__gallery-image" width={600} />
              <Image src={campingImg3} alt="Community at Dive Barn 2024" class="info__gallery-image" width={600} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="section section--faq">
      <div class="container">
        <Heading title="Quick Answers" />
        <div class="faq__container">

          <div class="faq__category">
            <h3 class="faq__category-title">Arrival & Parking</h3>

            <Accordion
              question="What time should I arrive?"
              answer="Gates open at 12:00 PM. If you're camping, arriving earlier gives you time to set up before the festivities kick off. Parking is free on-site."
            />

            <Accordion
              question="Can I leave and come back?"
              answer="Absolutely! Feel free to come and go as you please. The ranch is about 20 minutes from Cloverdale and Yorkville."
            />
          </div>

          <div class="faq__category">
            <h3 class="faq__category-title">Overnight Camping</h3>

            <Accordion
              question="Can I stay overnight?"
              answer="Yes! Many attendees stay on the ranch overnight. Bring shelter, warm layers, water for your entire stay, a headlamp, and breakfast/snacks for the morning."
            />

            <Accordion
              question="Can I camp in my car or RV?"
              answer="Absolutely! Car camping, tent camping, RV camping—it's all welcome. Someone's even bringing an RV this year! Just arrive early to find the best spot for your setup."
            />

            <Accordion
              question="Are there showers or bathrooms?"
              answer="We have porta potties on-site, but no showers. If you prefer full amenities, hotels in Cloverdale and Boonville are about 20 minutes away."
            />

            <Accordion
              question="Can I bring a camping stove?"
              answer="No camping stoves or open flames of any kind—the ranch is extremely dry in October. However, you're welcome to bring food and cook it on our communal grill!"
            />

            <Accordion
              question="Can I have a campfire?"
              answer="<strong>ABSOLUTELY NO FIRES ON THE PROPERTY.</strong> The ranch is extremely dry in October. No campfires, no candles, no flames of any kind. Safety first, always."
            />
          </div>

          <div class="faq__category">
            <h3 class="faq__category-title">Food & Drinks</h3>

            <Accordion
              question="Will there be food?"
              answer="Yes! We'll have full food service throughout the day, featuring a pig on a spit. Feel free to pack your own snacks too."
            />

            <Accordion
              question="What about drinks?"
              answer="We'll have beer, hard cider, and mixed drinks available. But we also recommend you BYOB if you have a favorite drink you want to enjoy!"
            />
          </div>

          <div class="faq__category">
            <h3 class="faq__category-title">WiFi & Connectivity</h3>

            <Accordion
              question="What's the WiFi?"
              answer="<strong>Network:</strong> Bungdaba West<br><strong>Password:</strong> beauxbeaux360<br><br>Cell service is spotty out here, but WiFi is available on the property for emergencies and staying connected."
            />
          </div>

        </div>
      </div>
    </section>

    <!-- Schedule CTA -->
    <section class="section">
      <CTA
        title="View the Full Schedule"
        text="Check out the complete lineup of performances, art installations, and events"
        buttonText="See Schedule"
        href="/schedule"
        variant="primary"
      />
    </section>
  </main>

  <!-- Footer -->
  <Footer />
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .main {
    min-height: 50vh;
  }

  .hero--attendee {
    display: block;
    min-height: 0;
  }

  .hero__image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Getting There section 50/50 split */
  .section--address .info__container {
    grid-template-columns: 1fr 1fr;
  }

  .section--address .info__gallery-image {
    height: auto;
    object-fit: contain;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .section--address .info__gallery a:hover img {
    opacity: 0.9;
  }

  .section--address .info__item-text {
    margin-bottom: var(--spacing-sm);
  }

  .section--address .info__gallery {
    gap: 0.25rem;
  }

  .image-caption {
    margin-top: 0;
    font-size: var(--typography-font-size-sm);
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  /* Welcome Section */
  .section--welcome {
    background: var(--color-surface-variant);
    padding: var(--spacing-xl) 0;
    margin: 0;
    max-width: none;
  }

  .welcome__container {
    max-width: 1200px;
    padding: 0 var(--spacing-lg);
    text-align: center;
    margin: 0 auto;
  }

  .welcome__title {
    font-family: var(--typography-font-family-display);
    font-size: var(--typography-font-size-2xl);
    font-weight: var(--typography-font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
    line-height: var(--typography-line-height-tight);
  }

  .welcome__text {
    font-size: var(--typography-font-size-lg);
    line-height: var(--typography-line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .container {
      padding: 0 var(--spacing-md);
    }

    .welcome__title {
      font-size: var(--typography-font-size-xl);
    }

    .welcome__text {
      font-size: var(--typography-font-size-base);
    }

    /* Stack two-column sections on mobile */
    .section--address .info__container,
    .section--camping .info__container {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    /* Hide camping photos on mobile */
    .section--camping .info__sidebar {
      display: none;
    }
  }
</style>
