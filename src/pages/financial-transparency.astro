---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingButton from '../components/ui/FloatingButton.astro';
import Heading from '../components/ui/Heading.astro';
import CTA from '../components/ui/CTA.astro';
import Table from '../components/ui/Table.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';

// Import the financial transparency page styles
import '../styles/pages/financial-transparency.css';

// Page metadata
const title = 'Financial Transparency - Dive Barn 2025';
const description = 'Complete transparency on how we fund and create Dive Barn 2025. See exactly where your support goes and help us reach our goals.';

// Funding data
const totalRaised = 3560;

// Unified Expenses Table
const expenseHeaders = ['Order', 'Expense', 'Amount'];
const expenseData = [
  ['-', 'Yorkville Schoolhouse Ranch (Event space)', 'In-kind donation'],
  ['-', 'Barn Safety Renovations', 'In-kind donation'],
  ['-', 'Porta Potties', 'In-kind donation'],
  ['-', 'Off Hours (Curators)', 'In-kind donation'],
  ['-', 'Jumbo\'s Win Win (Food services)', 'In-kind donation'],
  ['-', 'Lithgow BBQ (Food services)', 'In-kind donation'],
  ['1', 'Food and Bev costs', '$850'],
  ['2', 'QT Design Agency Fee', '$600'],
  ['3', 'Gas money for artists + bands', '$200'],
  ['4', 'Artist stipend', '$3,000'],
  ['5', 'Band fees', '$400']
];
---

<BaseLayout title={title} description={description}>
  <!-- Theme Toggle -->
  <ThemeToggle />
  
  <!-- Navigation -->
  <Navigation />

  <!-- Support Options -->
  <section class="section">
    <Heading 
      title="Support Dive Barn 2025" 
      subtitle="Every contribution helps us create an unforgettable experience"
    />
    
    <div class="support-grid">
      <div class="support-grid__image">
        <img src="/media/Selected Photo 2 1.png" alt="Dive Barn community moments" class="support-image">
      </div>
      <div class="support-grid__content">
        <h3 class="transparency-subheading">How We Fund Dive Barn</h3>
        <p class="transparency-statement">
          <strong>The entire project is self-funded.</strong> We've been very lucky to have some generous people on board to make it happen, but we're also scaling up from last year, which creates new costs. Donations will go towards subsidizing food and beverage, as well as design fees for branding/merchandise.
        </p>
        <p class="transparency-statement">
          This is made possible by incredible supporters: <strong>Eric Carlson and Barbara Henderson, Scott and Gerard for food and drink, Off Hours (our curators), Quality Time (our designers), all our amazing artists, and our friends and family</strong> who make this magic happen.
        </p>
      </div>
    </div>
  </section>

  <!-- Donation Call-to-Action -->
  <section class="section">
    <CTA 
      title="Help Make It Happen"
      text="Every contribution brings us closer to our goal."
      buttonText="DONATE NOW"
      href="https://venmo.com/dive-barn"
      variant="primary"
      target="_blank"
      rel="noopener"
    />
  </section>

  <!-- Expenses -->
  <section class="section">
    <Heading 
      title="All Expenses" 
      subtitle="In-kind donations and cash expenses for Dive Barn 2025"
    />
    
    <div class="financial-container">
      <Table 
        headers={expenseHeaders}
        data={expenseData}
      />
    </div>
  </section>


  <!-- Floating Donation Button -->
  <FloatingButton 
    href="https://venmo.com/dive-barn" 
    text="GIVE" 
 
    variant="primary" 
    position="bottom-right" 
    target="_blank" 
    rel="noopener" 
    ariaLabel="Donate to Dive Barn 2025"
  />

  <!-- Footer -->
  <Footer showTransparency lastUpdated="September 29, 2025" />
</BaseLayout>