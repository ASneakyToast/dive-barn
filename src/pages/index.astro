---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Heading from '../components/ui/Heading.astro';
import Hero from '../components/ui/Hero.astro';
import CTA from '../components/ui/CTA.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Accordion from '../components/ui/Accordion.astro';
import ArtistList from '../components/ui/ArtistList.astro';
import { SOCIAL_LINKS } from '../config/site';

// Get the latest year data for EVENT_INFO
const allYears = await getCollection('years');
const latestYear = allYears.sort((a, b) => b.data.year - a.data.year)[0];
const EVENT_INFO = {
  name: `Dive Barn ${latestYear.data.year}`,
  date: latestYear.data.date,
  startTime: latestYear.data.startTime || '12:00',
  endTime: latestYear.data.endTime || '23:00',
  location: 'Yorkville Schoolhouse Ranch, Mendocino County',
  description: latestYear.data.description
};
---

<BaseLayout
  title="Dive Barn - Arts Festival Archive"
  description={EVENT_INFO.description}
  type="event"
  date={EVENT_INFO.date}
>
  <!-- Theme Toggle -->
  <ThemeToggle />
  
  <!-- Navigation -->
  <Navigation />

  <!-- Hero Section -->
  <Hero
    id="hero"
    title="Dive Barn"
    subtitle="An arts and music gathering on a ranch in Mendocino County (2024-2025)"
    backgroundImages={[
      "/media/hero/IMG_0583.jpg",
      "/media/hero/IMG_0577.jpg",
      "/media/hero/IMG_0572.jpg",
      "/media/hero/IMG_0513.jpg",
      "/media/hero/IMG_0511.jpg",
    ]}
  />

  <!-- Barn Section -->
  <section id="barn" class="section section--barn">
    <Heading
      title="Thank You, 2025!"
      subtitle="Celebrating two years of creativity and community"
    />
    <div class="barn__container">
      <div class="barn__content">
        <h3 class="barn__heading">A celebration of art, music, and community</h3>
        <p class="barn__text">
          Beginning in 2024, Dive Barn is a gathering of artists and musicians on the Yorkville Schoolhouse Ranch, a property stewarded by the Henderson/Carlson family. This growing, one-day festival celebrates creativity and connection in a stunning rural setting.
        </p>
        <p class="barn__text">
          Explore artwork and memories from previous year's events. Discover the artists, musicians, and community moments that made Dive Barn unforgettable.
        </p>
        <Button href="/archive" variant="primary">
          See past events
        </Button>
      </div>

      <div class="barn__gallery">
        <img src="/media/hero/IMG_0568.jpg" alt="Colorful mask workshop inside barn" class="barn__image barn__image--large" />
        <img src="/media/hero/IMG_0572.jpg" alt="Group walking tour through festival grounds" class="barn__image" />
        <img src="/media/hero/IMG_0513.jpg" alt="Wooden ladder art piece over creek" class="barn__image" />
        <img src="/media/hero/IMG_0577.jpg" alt="Attendees gathered listening to presentation" class="barn__image barn__image--wide" />
        <img src="/media/hero/IMG_0515.jpg" alt="Close-up of wooden ladder sculpture" class="barn__image" />
        <img src="/media/hero/IMG_0587.jpg" alt="Community gathering at festival" class="barn__image" />
        <img src="/media/hero/IMG_0529.jpg" alt="Two people wearing handmade blue masks" class="barn__image" />
      </div>
    </div>
  </section>

  <!-- What's Next Section -->
  <section id="whats-next" class="section section--whats-next">
    <Heading
      title="What's Next"
      subtitle="The organizers continue to create and connect"
    />
    <div class="whats-next__container">
      <div class="whats-next__card whats-next__card--with-bg" style="background-image: url('/media/hero/IMG_0624.jpg');">
        <div class="whats-next__card-overlay"></div>
        <div class="whats-next__card-content">
          <h3 class="whats-next__title">This Is A House Gallery</h3>
          <p class="whats-next__text">A DIY House Gallery in Oakland, California.</p>
          <Button href="https://thisisahousegallery.com" variant="primary" target="_blank" rel="noopener">
            Visit Gallery
          </Button>
        </div>
      </div>

      <div class="whats-next__card whats-next__card--with-bg" style="background-image: url('/media/hero/IMG_0577.jpg');">
        <div class="whats-next__card-overlay"></div>
        <div class="whats-next__card-content">
          <h3 class="whats-next__title">Off Hours SF</h3>
          <p class="whats-next__text">A west coast curatorial collective.</p>
          <Button href="https://www.instagram.com/offhours_sf/" variant="primary" target="_blank" rel="noopener">
            Follow on Instagram
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="section section--faq">
    <Heading title="Frequently Asked Questions" />
    <div class="faq__container">

      <h3 class="faq__section-heading">About Dive Barn</h3>

      <Accordion
        question="What was Dive Barn?"
        answer="Dive Barn was a one-day festival of art, music, and community on the Yorkville Schoolhouse Ranch in Mendocino County, CA. Running in 2024 and 2025, it was a free, all-ages gathering that celebrated creativity and connection in a stunning rural setting."
      />

      <Accordion
        question="What happened at Dive Barn?"
        answer="Each year featured a curated lineup of live music, art installations, and interactive experiences—all set against the stunning backdrop of a 2,000-acre ranch in Mendocino County."
      />

      <Accordion
        question="Where was it located?"
        answer="Dive Barn took place at the Yorkville Schoolhouse Ranch in Mendocino County, California—a 2,000-acre property about 20 minutes from Cloverdale."
      />

      <h3 class="faq__section-heading">Looking Back</h3>

      <Accordion
        question="Is Dive Barn happening again?"
        answer="After two wonderful years, Dive Barn has concluded. Thank you to everyone who made it special—the artists, musicians, volunteers, and all who attended."
      />

      <Accordion
        question="How can I stay connected with the organizers?"
        answer="The spirit of Dive Barn lives on through the organizers' ongoing projects. Visit <a href='https://thisisahousegallery.com' target='_blank' rel='noopener'>This Is A House Gallery</a> and follow <a href='https://www.instagram.com/offhours_sf/' target='_blank' rel='noopener'>Off Hours SF on Instagram</a> to stay connected."
      />

    </div>
  </section>

  <!-- Featured Cards Section -->
  <section class="section section--featured-cards" style="background-image: url('/media/hero/IMG_0568.jpg'); background-size: cover; background-position: center; position: relative;">
    <div class="featured-cards__overlay"></div>
    <div class="featured-cards__grid">
      <Card href="/archive" hoverable>
        <div class="db-card-header">
          <div class="db-card-content">
            <h3 class="db-card-title">Archive</h3>
          </div>
        </div>
        <p class="db-card-text">View all the artists, musicians, and moments from 2024 and 2025.</p>
        <span class="db-card-link">See archive →</span>
      </Card>

      <Card href="/schedule" hoverable>
        <div class="db-card-header">
          <div class="db-card-content">
            <h3 class="db-card-title">Schedule</h3>
          </div>
        </div>
        <p class="db-card-text">See what a day at Dive Barn looked like, from afternoon art installations to evening performances.</p>
        <span class="db-card-link">View schedule →</span>
      </Card>

      <Card href="/yorkville-schoolhouse-ranch" hoverable>
        <div class="db-card-header">
          <div class="db-card-content">
            <h3 class="db-card-title">Historic Property</h3>
          </div>
        </div>
        <p class="db-card-text">Discover the rich history of the 2,000-acre ranch, from its origins as a schoolhouse to its role in Mendocino County's agricultural heritage.</p>
        <span class="db-card-link">Learn the history →</span>
      </Card>
    </div>
  </section>

  <!-- Footer -->
  <Footer />
</BaseLayout>

<style>
  /* Barn Section */
  .barn__container {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--spacing-xl);
    max-width: 1400px;
    margin: 0 auto;
    align-items: start;
  }

  .barn__content {
  }

  .barn__heading {
    font-family: var(--typography-font-family-display);
    font-size: var(--typography-font-size-xl);
    font-weight: var(--typography-font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
    line-height: var(--typography-line-height-tight);
  }

  .barn__text {
    font-size: var(--typography-font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--typography-line-height-relaxed);
    margin-bottom: var(--spacing-md);
  }

  /* Bento Box Gallery */
  .barn__gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 200px);
    gap: var(--spacing-sm);
  }

  .barn__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--border-radius-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .barn__image:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    z-index: 1;
  }

  /* Bento Box variations */
  .barn__image--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .barn__image--wide {
    grid-column: span 2;
  }

  .barn__image--tall {
    grid-row: span 2;
  }

  /* Featured Cards with Background */
  .section--featured-cards {
    position: relative;
  }

  .featured-cards__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1;
  }

  .featured-cards__grid {
    position: relative;
    z-index: 2;
  }

  /* FAQ Section Headings */
  .faq__section-heading {
    font-family: var(--typography-font-family-display);
    font-size: var(--typography-font-size-lg);
    font-weight: var(--typography-font-weight-semibold);
    color: var(--color-text-primary);
    margin: var(--spacing-xl) 0 var(--spacing-md) 0;
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .faq__section-heading:first-of-type {
    margin-top: 0;
  }

  /* FAQ Footer Note */
  .faq__footer-note {
    text-align: center;
    margin-top: var(--spacing-lg);
    font-size: var(--typography-font-size-base);
    color: var(--color-text-secondary);
  }

  .faq__footer-note a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--typography-font-weight-semibold);
  }

  .faq__footer-note a:hover {
    text-decoration: underline;
  }

  /* What's Next Section */
  .section--whats-next {
    background: var(--color-surface-variant);
  }

  .whats-next__container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .whats-next__card {
    background: var(--color-surface);
    padding: var(--spacing-xl);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
  }

  .whats-next__card--with-bg {
    background-size: cover;
    background-position: center;
    border: none;
  }

  .whats-next__card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.8) 100%);
    z-index: 1;
  }

  .whats-next__card-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .whats-next__title {
    font-family: var(--typography-font-family-display);
    font-size: var(--typography-font-size-xl);
    font-weight: var(--typography-font-weight-bold);
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }

  .whats-next__text {
    font-size: var(--typography-font-size-base);
    color: rgba(255, 255, 255, 0.9);
    line-height: var(--typography-line-height-relaxed);
    margin-bottom: var(--spacing-lg);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .barn__container {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .barn__content {
      padding-right: 0;
    }

    .barn__gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(6, 200px);
    }

    .barn__image--large,
    .barn__image--wide,
    .barn__image--tall {
      grid-column: span 1;
      grid-row: span 1;
    }

    .whats-next__container {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }
</style>
