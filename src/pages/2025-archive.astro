---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import CTA from '../components/ui/CTA.astro';
import NewsletterSignup from '../components/ui/NewsletterSignup.astro';
import FilterBar from '../components/ui/FilterBar.astro';
import PhotoWall from '../components/ui/PhotoWall.astro';
import PhotoLightbox from '../components/ui/PhotoLightbox.astro';
import ArtistPanel from '../components/ui/ArtistPanel.astro';
import { allPhotos, getAllYears } from '../data/allPhotos';

const years = getAllYears();
---

<BaseLayout
  title="Dive Barn - Festival Photo Archive"
  description="Explore the complete visual archive from Dive Barn 2024 and 2025 - art installations, community moments, and unforgettable memories from our annual gathering."
  type="event"
  date="2025-10-11"
>
  <!-- Theme Toggle -->
  <ThemeToggle />

  <!-- Navigation -->
  <Navigation />

  <!-- Photo Wall -->
  <PhotoWall photos={allPhotos} />

  <!-- Filter Bar -->
  <FilterBar years={years} />

  <!-- Photo Lightbox -->
  <PhotoLightbox />

  <!-- Artist Panel -->
  <ArtistPanel />

  <!-- Newsletter CTA Section -->
  <section class="section">
    <CTA
      variant="newsletter"
      title="Join Us for Dive Barn 2026"
      text="Subscribe to our newsletter for 2026 announcements, artist application openings, and volunteer opportunities."
    >
      <NewsletterSignup variant="default" title="" description="" hidePrivacy={true} />
    </CTA>
  </section>

  <!-- Footer -->
  <Footer />
</BaseLayout>
